# Example environment configuration for Model Failure Lab.
# Copy to `.env` and fill in real values. `.env` is gitignored — never commit secrets.
#
# The production workflow (run/report/compare with `--model demo`) needs NONE of these.
# These are only required when you use a real model adapter.

# --- Anthropic adapter (`--model anthropic:<model>`; needs the [anthropic] extra) ---
ANTHROPIC_API_KEY=

# --- OpenAI adapter (OpenAI model names; needs the [openai] extra) ---
OPENAI_API_KEY=

# --- Ollama adapter (`--model ollama:<model>`; needs a local Ollama runtime) ---
# No API key and no env var: Ollama defaults to http://localhost:11434. A custom
# endpoint is passed as a model option (base_url), not through the environment.

# --- Artifact workspace (optional) ---
# The React debugger UI reads artifacts from this directory.
# FAILURE_LAB_ARTIFACT_ROOT=/path/to/workspace
