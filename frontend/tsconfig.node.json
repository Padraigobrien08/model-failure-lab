{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    // ES2022 for the Node-side code: `server/` is real application code now, and its tests
    // use top-level await.
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "allowSyntheticDefaultImports": true,
    "types": ["node"]
  },
  "include": ["vite.config.ts", "vitest.config.ts", "tailwind.config.ts", "server"]
}
